# ============================================================================
# AI Web Doctor — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# Django
DEBUG=True
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Public site URL used for canonical/OG/sitemap URLs (e.g. https://example.com)
SITE_URL=http://localhost:8000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_web_doctor

# Scan execution mode (worker is optional; dev default runs scans in-process)
# SCAN_WORKER_MODE=False
# Celery queue (optional — needs a broker like Redis)
# CELERY_TASK_ALWAYS_EAGER=True
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gemini multimodal AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=1
# Text-only analysis by default: screenshots are the biggest input-token cost.
# Set to True only if you want screenshots included (much higher token usage).
AI_SEND_IMAGES=False
# Hard cap on prompt text tokens per request (analysis + fix generation).
AI_MAX_PROMPT_TOKENS=15000
AI_ENABLED=True

# Chromium memory tuning (low-memory mode)
CHROMIUM_V8_HEAP_MB=144
SCAN_AXE_VIEWPORTS=desktop # "desktop" runs axe on the desktop viewport only; "all" runs it everywhere
SCAN_DOM_SNAPSHOT_LIMIT=80
# Scan resource limits
MAX_SCAN_DURATION=120
SCAN_MAX_DURATION_SECONDS=300 # Hard kill deadline for the scan subprocess (watchdog)
MAX_CONCURRENT_SCANS=2
MAX_REDIRECTS=5
MAX_RESPONSE_SIZE=5242880
MAX_SCREENSHOTS=16
MAX_SCREENSHOT_SIZE=8388608
MAX_AI_REQUEST_SIZE=4194304

# Daily scan quotas (rate limiting)
RATE_LIMIT_ANONYMOUS_SCANS_PER_DAY=20
RATE_LIMIT_AUTHED_SCANS_PER_DAY=10
# Set to True only when running behind a trusted proxy
TRUST_X_FORWARDED_FOR=False

# Playwright
PLAYWRIGHT_HEADLESS=True
SCAN_PAGE_TIMEOUT_MS=30000
SCAN_NETWORK_IDLE_TIMEOUT_MS=1500
# Single-process Chromium with capped V8 heaps — fits ~200MB RAM hosts.
CHROMIUM_LOW_MEMORY_MODE=True
# Abort fonts/media/tracker requests during scans (speed + memory).
SCAN_BLOCK_HEAVY_RESOURCES=True
# Extreme low-memory mode: also abort image requests (~270MB peak vs ~340MB).
# Slightly less accurate responsive checks; only for hosts under ~300MB.
SCAN_BLOCK_IMAGES=False
# Run scans in a short-lived subprocess so Chromium memory is freed after each
# scan and an OOM can never kill the web process. Set True in production.
SCAN_SUBPROCESS_MODE=False
# Viewports to scan, as JSON pairs [width, height]. Defaults to 9 viewports
# (320..1440px). Use fewer on low-memory hosts, e.g. "[[320,800],[390,844],[768,1024],[1440,900]]".
SCAN_VIEWPORTS=

# Structured logging
LOG_LEVEL=INFO
