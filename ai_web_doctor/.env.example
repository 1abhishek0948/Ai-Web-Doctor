# ============================================================================
# AI Web Doctor — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# Django
DEBUG=True
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Public site URL used for canonical/OG/sitemap URLs (e.g. https://example.com)
SITE_URL=http://localhost:8000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_web_doctor

# Redis (used by Celery for background scans)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gemini multimodal AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=1
AI_ENABLED=True

# Scan resource limits
MAX_SCAN_DURATION=120
MAX_CONCURRENT_SCANS=2
MAX_REDIRECTS=5
MAX_RESPONSE_SIZE=5242880
MAX_SCREENSHOTS=16
MAX_SCREENSHOT_SIZE=8388608
MAX_AI_REQUEST_SIZE=4194304

# Daily scan quotas (rate limiting)
RATE_LIMIT_ANONYMOUS_SCANS_PER_DAY=3
RATE_LIMIT_AUTHED_SCANS_PER_DAY=10
# Set to True only when running behind a trusted proxy
TRUST_X_FORWARDED_FOR=False

# Playwright
PLAYWRIGHT_HEADLESS=True
SCAN_PAGE_TIMEOUT_MS=30000
SCAN_NETWORK_IDLE_TIMEOUT_MS=10000

# Structured logging
LOG_LEVEL=INFO
